# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & Authentication (TradingView Webhook)
WEBHOOK_SECRET=your_super_secret_token_here

# Discord Webhook Configuration (Optional: for direct TradingView webhook forwarding)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url/here
DISCORD_BOT_USERNAME=TradingView Alert Bot
DISCORD_AVATAR_URL=https://upload.wikimedia.org/wikipedia/commons/e/e4/TradingView_Logo.svg

# Discord Bot Configuration (Required for /alert slash commands and autonomous price tracking)
# Create bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Target Discord Channel ID where price alerts will be announced (Leave empty to use command channel)
DISCORD_ALERT_CHANNEL_ID=

# Outbound Proxy Configuration (CRITICAL FOR TURKEY / REGIONS BLOCKING DISCORD)
# In Turkey, Discord is blocked by ISPs, resulting in SSLCertVerificationError.
# Run the Cloudflare WARP container and set this proxy:
# If using Docker Compose: http://warp:1080
# If using Coolify standalone: http://warp:1080
DISCORD_PROXY=http://warp:1080

# Autonomous Price Alert Engine Limits
# Maximum concurrent active alerts in the database
MAX_ACTIVE_ALERTS=100
# Automatic expiration duration (in days) for forgotten/stale alerts (e.g. 180 days = 6 months)
ALERT_EXPIRY_DAYS=180
# SQLite database storage path
SQLITE_DB_PATH=/app/data/alerts.db

# Polling Interval (in seconds) for non-crypto assets (BIST, US Stocks, Forex, Gold)
YAHOO_POLL_INTERVAL_SECONDS=20.0

# Rate Limiting & Queue Settings
RATE_LIMIT_PER_SECOND=2
MAX_QUEUE_CAPACITY=500
